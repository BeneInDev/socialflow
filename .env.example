# SocialFlow — variáveis de ambiente
#
# Copie para .env e preencha com os dados públicos do seu projeto Supabase.
# Variáveis VITE_ são incorporadas ao JavaScript enviado ao navegador.
# Nunca use service_role, sb_secret_ ou senha do banco aqui.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legada, usada somente se a publishable key estiver vazia:
# VITE_SUPABASE_ANON_KEY=
